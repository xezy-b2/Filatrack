# URL de connexion MongoDB (MongoDB Atlas ou instance auto-hébergée)
# Exemple Atlas : mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/filatrack
MONGODB_URI=mongodb://localhost:27017/filatrack

# Clé secrète utilisée par NextAuth pour signer les sessions/JWT.
# Générer une valeur aléatoire avec : openssl rand -base64 32
AUTH_SECRET=change-moi-avec-une-valeur-aleatoire

# URL publique du site (utile en production sur Railway/Vercel)
# Exemple : https://filatrack.up.railway.app
NEXTAUTH_URL=http://localhost:3000

# Clé API Resend (https://resend.com — offre gratuite), utilisée pour
# envoyer l'email de réinitialisation de mot de passe ("mot de passe
# oublié"). Facultative en développement : si absente, le lien de
# réinitialisation est simplement affiché dans les logs du serveur au lieu
# d'être envoyé par email, ce qui permet de tester la fonctionnalité sans
# compte Resend. En production, à définir pour que l'email parte vraiment.
RESEND_API_KEY=

# Adresse d'expédition des emails envoyés par le site (doit correspondre à
# un domaine vérifié sur Resend en production ; la valeur par défaut
# "onboarding@resend.dev" ne fonctionne qu'en test).
EMAIL_FROM=FilaTrack <onboarding@resend.dev>
